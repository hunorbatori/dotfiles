# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

{{ if eq .chezmoi.osRelease.id "bazzite" -}}
# Homebrew — Bazzite only. Bash gets this from /etc/profile.d/, which zsh
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{ end -}}

# Enable multi line command edit with C-x C-e
autoload -U edit-command-line
zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

fpath=(~/.zsh/zsh-completions/src $fpath)

# Load completions on start
autoload -U compinit && compinit
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh

source ~/.zsh/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# source ~/.zsh/zsh-autocomplete/zsh-autocomplete.plugin.zsh
# source ~/.zsh-autosuggestions.zsh
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source ~/.nnn-conf
source ~/.global_functions


# Enable fzf fuzzy find shell integration
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Enable jump
eval "$(jump shell zsh)"

# KeyBindings

# Bind Up/Down arrows to history search (filter by current input)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search   # Up Arrow
bindkey '^[[B' down-line-or-beginning-search # Down Arrow

# Accept one word of the suggestion on arrowRight
bindkey "^[[C" forward-word
# Accept the whole suggestion on ctrl+arrowRight
bindkey "^[[1;5C" autosuggest-accept
# Jump backward in prompt on ctrl+arrowLeft
bindkey "^[[1;5D" backward-word
# History search on ctrl+arrowUp
bindkey "^[[1;5A" history-search-backward
# History search on ctrl+arrowDown
bindkey "^[[1;5B" history-search-forward

# Tell zsh-autosuggestions not to clear suggestions during history search
ZSH_AUTOSUGGEST_CLEAR_WIDGETS=("${(@)ZSH_AUTOSUGGEST_CLEAR_WIDGETS:#(up|down)-line-or-history}")
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(history-substring-search-up history-substring-search-down)
ZSH_AUTOSUGGEST_IGNORE_WIDGETS+=(up-line-or-beginning-search down-line-or-beginning-search)

# Enable and configure zsh histroy
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
HISTUDP=erase
setopt share_history
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Set default editor to nano
export EDITOR=nano

# Completion styling
# Color folders according to ls --color
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Disable default menu in favow of fzf-tab
# zstyle ':completion:*' menu no

# Aliases
alias ls='ls --color'
# Force Kate to use the X11 (XCB) backend on Wayland to fix the horizontal-line UI bug
if (( $+commands[kate] )); then
    alias kate='QT_QPA_PLATFORM=xcb command kate'
fi
